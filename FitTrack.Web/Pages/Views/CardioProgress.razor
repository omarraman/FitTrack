@page "/cardio/progress"
@using System.Globalization
@using System.Text
@inject ICardioSessionService CardioSvc

<h1>Cardio progress</h1>
<p class="page-kicker">Session performance by airbike session date.</p>

<div class="card">
    <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:12px;">
        <h3 style="margin:0;">Performance graphs</h3>
        <a class="btn btn-ghost btn-sm" href="/cardio">Back to cardio sessions</a>
    </div>

    @if (_sessions.Count == 0)
    {
        <p class="text-dim">No sessions logged yet.</p>
    }
    else
    {
        <h3>Average watts</h3>
        @((MarkupString)BuildChart("Average watts", "Watts", "W", s => s.Watts, "#4f8ef7"))
        <h3 style="margin-top:24px;">Average speed</h3>
        @((MarkupString)BuildChart("Average speed", "Speed (km/h)", "km/h", s => s.MaxSpeedKph, "#22c55e"))
        <h3 style="margin-top:24px;">Average calories</h3>
        @((MarkupString)BuildChart("Average calories", "Calories", "kcal", s => s.Calories, "#f59e0b"))
    }
</div>

@code {
    private List<CardioSessionDto> _sessions = new();

    protected override async Task OnInitializedAsync() =>
        _sessions = await CardioSvc.ListAsync();

    private string BuildChart(
        string chartLabel,
        string axisLabel,
        string unit,
        Func<CardioSessionDto, decimal> valueSelector,
        string colour)
    {
        const int width = 760, height = 320;
        const int plotLeft = 62, plotRight = 22, plotTop = 20, plotBottom = 64;
        var plotWidth = width - plotLeft - plotRight;
        var plotHeight = height - plotTop - plotBottom;
        var points = _sessions
            .OrderBy(s => s.SessionDate)
            .ThenBy(s => s.Id)
            .ToList();
        var minDate = points.Min(s => s.SessionDate).DayNumber;
        var maxDate = points.Max(s => s.SessionDate).DayNumber;
        var maxValue = Math.Max(1m, points.Max(valueSelector));
        var yStep = Math.Max(1, (int)Math.Ceiling(maxValue / 4m));
        var yMax = yStep * 4;

        double X(CardioSessionDto session) => maxDate == minDate
            ? plotLeft + plotWidth / 2d
            : plotLeft + (session.SessionDate.DayNumber - minDate) / (double)(maxDate - minDate) * plotWidth;
        double Y(decimal value) => plotTop + plotHeight - (double)(value / yMax) * plotHeight;
        string Number(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

        var svg = new StringBuilder();
        svg.Append($"<svg viewBox=\"0 0 {width} {height}\" role=\"img\" aria-label=\"{chartLabel} by date\" style=\"width:100%; height:auto; display:block;\">");

        for (var i = 0; i <= 4; i++)
        {
            var value = i * yStep;
            var y = Y(value);
            svg.Append($"<line x1=\"{plotLeft}\" y1=\"{Number(y)}\" x2=\"{width - plotRight}\" y2=\"{Number(y)}\" stroke=\"#444\" stroke-width=\"1\" stroke-dasharray=\"4,3\"/>");
            svg.Append($"<text x=\"{plotLeft - 8}\" y=\"{Number(y)}\" text-anchor=\"end\" dominant-baseline=\"middle\" font-size=\"11\" fill=\"#888\">{value}</text>");
        }

        svg.Append($"<line x1=\"{plotLeft}\" y1=\"{plotTop}\" x2=\"{plotLeft}\" y2=\"{plotTop + plotHeight}\" stroke=\"#666\" stroke-width=\"1.5\"/>");
        svg.Append($"<line x1=\"{plotLeft}\" y1=\"{plotTop + plotHeight}\" x2=\"{width - plotRight}\" y2=\"{plotTop + plotHeight}\" stroke=\"#666\" stroke-width=\"1.5\"/>");
        svg.Append($"<text x=\"16\" y=\"{plotTop + plotHeight / 2}\" text-anchor=\"middle\" transform=\"rotate(-90 16 {plotTop + plotHeight / 2})\" font-size=\"11\" fill=\"#aaa\">{axisLabel}</text>");
        svg.Append($"<text x=\"{plotLeft + plotWidth / 2}\" y=\"{height - 8}\" text-anchor=\"middle\" font-size=\"11\" fill=\"#aaa\">Date</text>");

        if (points.Count > 1)
        {
            var polyline = string.Join(" ", points.Select(s => $"{Number(X(s))},{Number(Y(valueSelector(s)))}"));
            svg.Append($"<polyline points=\"{polyline}\" fill=\"none\" stroke=\"{colour}\" stroke-width=\"2.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>");
        }

        foreach (var session in points)
        {
            var x = X(session);
            var value = valueSelector(session);
            var y = Y(value);
            var label = session.SessionDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            svg.Append($"<line x1=\"{Number(x)}\" y1=\"{plotTop + plotHeight}\" x2=\"{Number(x)}\" y2=\"{plotTop + plotHeight + 5}\" stroke=\"#666\"/>");
            svg.Append($"<circle cx=\"{Number(x)}\" cy=\"{Number(y)}\" r=\"5\" fill=\"{colour}\" stroke=\"#1a1a1a\" stroke-width=\"2\"><title>{label}: {value:0.##} {unit}</title></circle>");
            svg.Append($"<text x=\"{Number(x)}\" y=\"{Number(y - 10)}\" text-anchor=\"middle\" font-size=\"11\" fill=\"{colour}\">{value:0.##}</text>");
            svg.Append($"<text x=\"{Number(x)}\" y=\"{plotTop + plotHeight + 18}\" text-anchor=\"end\" transform=\"rotate(-35 {Number(x)} {plotTop + plotHeight + 18})\" font-size=\"10\" fill=\"#888\">{label}</text>");
        }

        svg.Append("</svg>");
        return svg.ToString();
    }
}
