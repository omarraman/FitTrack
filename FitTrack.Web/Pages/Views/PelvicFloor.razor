    private async Task DeleteSession(int sessionId)
    {
        if (_summary is null) return;
        if (!await ConfirmSvc.ConfirmAsync("Delete this pelvic-floor session? Adherence totals are recalculated.")) return;

        _error = null;
        try
        {
            await Svc.DeleteSessionAsync(_summary.Id, sessionId);
            await Reload();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task DeleteCheckIn(int checkInId)
    {
        if (_summary is null) return;
        if (!await ConfirmSvc.ConfirmAsync("Delete this daily check-in?")) return;

        _error = null;
        try
        {
            await Svc.DeleteCheckInAsync(_summary.Id, checkInId);
            await Reload();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    public async ValueTask DisposeAsync() => await StopTimerLoopAsync();
}
